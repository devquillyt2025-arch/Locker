# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string (Project Settings -> Database -> Connection
# string -> Transaction pooler, port 6543). Used by Drizzle (server-only)
# and by `drizzle-kit migrate`/`push`.
DATABASE_URL=

# The only Google account allowed to use this Locker. Requests from any
# other signed-in account are rejected in middleware and in every Server
# Action.
ALLOWED_EMAIL=devquillyt2025@gmail.com

# Phase 4: web push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
