# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string (Project Settings -> Database -> Connection
# string -> Transaction pooler, port 6543). Used by Drizzle (server-only)
# and by `drizzle-kit migrate`/`push`.
DATABASE_URL=

# The only Google account allowed to use this Locker. Requests from any
# other signed-in account are rejected in middleware and in every Server
# Action.
ALLOWED_EMAIL=devquillyt2025@gmail.com

# Dev-only: skips the Google sign-in gate so you can use the app before
# Google OAuth is set up in Supabase Auth. Ignored outside dev no matter
# what — see src/lib/auth.ts. Leave unset once sign-in is wired up.
SKIP_AUTH=

# Phase 4: web push (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Drive uploads (optional). Lets the Documents page upload files to your
# own Drive and add the link to the card. Create an OAuth client in Google
# Cloud Console (type: Web application) with this redirect URI:
#   http://localhost:3001/api/drive/callback
# Full steps: README.md ("Google Drive uploads"), or the Documents page itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
